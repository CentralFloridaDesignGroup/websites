{
  "compilerOptions": {
    "target": "ES2020",
    "jsx": "react-jsx",
    "useDefineForClassFields": true,
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "strict": true,
    "noImplicitAny": true,
    "strictNullChecks": true,
    "strictFunctionTypes": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noImplicitReturns": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "moduleResolution": "bundler",
    "paths": {
      "@styles/*": ["./styles/*"],
      "cfdg/input": ["./packages/cfdg/input/src"],
      "cfdg/input/*": ["./packages/cfdg/input/src/*"],
      "cfdg/layout": ["./packages/cfdg/layout/src"],
      "cfdg/layout/*": ["./packages/cfdg/layout/src/*"],
      "cfdg/scripts": ["./packages/cfdg/scripts/src"],
      "cfdg/scripts/*": ["./packages/cfdg/scripts/src/*"],
      "cfdg/types/v1": ["./packages/cfdg/types/src/v1"],
      "cfdg/types/v1/*": ["./packages/cfdg/types/src/v1/*"],
      "cfdg/types/v2": ["./packages/cfdg/types/src/v2"],
      "cfdg/types/v2/*": ["./packages/cfdg/types/src/v2/*"],
      "cfdg/ui/input": ["./packages/cfdg/ui/src/input"],
      "cfdg/ui/input/*": ["./packages/cfdg/ui/src/input/*"],
      "cfdg/ui/layout": ["./packages/cfdg/ui/src/layout"],
      "cfdg/ui/layout/*": ["./packages/cfdg/ui/src/layout/*"]
    }
  },
  "include": ["packages", "sites"],
  "exclude": ["**/dist", "**/node_modules"],
  "references": [
    { "path": "./packages/cfdg/input" },
    { "path": "./packages/cfdg/layout" },
    { "path": "./packages/cfdg/scripts" },
    { "path": "./packages/cfdg/types" },
    { "path": "./packages/cfdg/ui" },
    { "path": "./sites/main" },
    { "path": "./sites/document" },
    { "path": "./sites/northstar" },
    { "path": "./sites/client" },
    { "path": "./sites/api" }
  ]
}
