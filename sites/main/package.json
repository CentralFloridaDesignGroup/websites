{
  "name": "sites-main",
  "version": "1.0.0",
  "description": "Main website for SWP",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "deploy": "pnpm run build && wrangler pages deploy dist",
    "deploy:preview": "pnpm run build && wrangler pages deploy dist --branch preview"
  },
  "dependencies": {
    "@wps/input": "workspace:*",
    "@wps/layout": "workspace:*",
    "@wps/scripts": "workspace:*",
    "@tailwindcss/vite": "^4.1.18",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.28",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.7.0",
    "tailwindcss": "^4.2.1",
    "typescript": "^5.9.3",
    "vite": "^5.4.21",
    "wrangler": "^4.69.0",
    "react-router-dom": "^7.13.1"
  }
}
