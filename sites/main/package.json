{
  "name": "main",
  "version": "5.0.0",
  "description": "Main website for the White Point Survey family of web applications",
  "type": "module",
  "scripts": {
    "dev": "vite --port 5100",
    "build": "tsc && vite build && node scripts/prerender.mjs",
    "prerender:install": "node scripts/ensure-playwright-browser.mjs",
    "preview": "vite preview",
    "deploy": "pnpm run prerender:install && pnpm run build && wrangler pages deploy dist --branch main",
    "deploy:preview": "pnpm run prerender:install && pnpm run build && wrangler pages deploy dist --branch preview"
  },
  "dependencies": {
    "@headlessui/react": "2.2.10",
    "cfdg/input": "workspace:*",
    "cfdg/layout": "workspace:*",
    "cfdg/scripts": "workspace:*",
    "cfdg/types": "workspace:*",
    "cfdg/ui": "workspace:*",
    "d3-geo": "3.1.1",
    "lucide-react": "1.26.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-router-dom": "7.18.1",
    "topojson-client": "3.1.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20260724.1",
    "@tailwindcss/vite": "4.3.3",
    "@types/d3-geo": "3.1.0",
    "@types/geojson": "7946.0.16",
    "@types/node": "26.1.1",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@types/topojson-client": "3.1.5",
    "@types/topojson-specification": "1.0.5",
    "@vitejs/plugin-react": "6.0.4",
    "playwright": "1.62.0",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "vite": "8.1.5",
    "wrangler": "4.114.0"
  }
}
