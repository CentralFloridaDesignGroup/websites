{
  "name": "sites-main",
  "version": "1.0.0",
  "description": "Main website for SWP",
  "type": "module",
  "scripts": {
    "dev": "vite --port 5100",
    "build": "tsc && vite build && node scripts/prerender.mjs",
    "prerender:install": "node scripts/ensure-playwright-browser.mjs",
    "preview": "vite preview",
    "deploy": "pnpm run prerender:install && pnpm run build && wrangler pages deploy dist --branch main",
    "deploy:preview": "pnpm run prerender:install && pnpm run build && wrangler pages deploy dist --branch preview"
  },
  "dependencies": {
    "@headlessui/react": "latest",
    "@types/topojson-specification": "latest",
    "@wps/input": "workspace:*",
    "@wps/layout": "workspace:*",
    "@wps/scripts": "workspace:*",
    "d3-geo": "latest",
    "lucide-react": "latest",
    "react": "latest",
    "react-dom": "latest",
    "react-router-dom": "latest",
    "topojson-client": "latest"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "latest",
    "@tailwindcss/vite": "latest",
    "@types/d3-geo": "latest",
    "@types/geojson": "latest",
    "@types/node": "latest",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "@types/topojson-client": "latest",
    "@vitejs/plugin-react": "latest",
    "json-schema-to-typescript": "latest",
    "playwright": "^1.61.1",
    "tailwindcss": "latest",
    "typescript": "latest",
    "vite": "latest",
    "wrangler": "latest"
  }
}
