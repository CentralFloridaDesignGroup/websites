{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "$id": "https://api.whitepointsurvey.com/schemas/plattingRequirementSet.json",
    "title": "Platting Requirement Set",
    "description": "An authored, reusable set of platting checklist requirements (e.g. Florida statutes, White Point standards, or a jurisdiction's local requirements) composed into checklists by composePlattingChecklists.mjs.",
    "type": "object",
    "properties": {
        "id": {
            "type": "string",
            "description": "The unique identifier of this requirement set, referenced by jurisdiction profiles' \"include\" arrays.",
            "pattern": "^[a-z0-9-]+$"
        },
        "Sections": {
            "type": "array",
            "description": "The ordered sections contributed by this requirement set.",
            "items": {
                "type": "object",
                "properties": {
                    "title": {
                        "type": "string",
                        "description": "The section heading displayed on the checklist."
                    },
                    "subtitle": {
                        "type": "string",
                        "description": "Optional supporting text shown under the section title."
                    },
                    "items": {
                        "type": "array",
                        "description": "The requirement rows within this section.",
                        "items": {
                            "type": "object",
                            "properties": {
                                "id": {
                                    "type": "string",
                                    "description": "The unique identifier of this requirement, referenced by relatedRequirementId. Must be unique across the entire composed checklist.",
                                    "pattern": "^[a-z0-9-]+$"
                                },
                                "title": {
                                    "type": "string",
                                    "description": "A short label for the requirement.",
                                    "minLength": 1
                                },
                                "statement": {
                                    "type": "string",
                                    "description": "The requirement text shown to the reviewer.",
                                    "minLength": 1
                                },
                                "code": {
                                    "type": "string",
                                    "description": "The citation or basis for the requirement (statute section, \"Standard Practice\", \"QA review\", or \"Local requirements - verify\").",
                                    "minLength": 1
                                },
                                "options": {
                                    "type": "string",
                                    "description": "The response control shown for this requirement.",
                                    "enum": ["YesNo", "YesNoN/A"]
                                },
                                "source": {
                                    "type": "object",
                                    "description": "The authority backing this requirement.",
                                    "properties": {
                                        "label": {
                                            "type": "string",
                                            "description": "A human-readable name for the source.",
                                            "minLength": 1
                                        },
                                        "url": {
                                            "type": "string",
                                            "description": "An optional link to the source document.",
                                            "format": "uri",
                                            "pattern": "^https?://"
                                        }
                                    },
                                    "required": ["label"]
                                },
                                "reviewStatus": {
                                    "type": "string",
                                    "description": "Whether this requirement has been verified against its source.",
                                    "enum": ["draft", "reviewed"]
                                },
                                "reviewedAt": {
                                    "type": ["string", "null"],
                                    "description": "The date this requirement was last reviewed, in yyyy-mm-dd format. Required when reviewStatus is \"reviewed\".",
                                    "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
                                },
                                "relatedRequirementId": {
                                    "type": "string",
                                    "description": "An optional id of another requirement in the composed checklist that this item relates to."
                                }
                            },
                            "required": ["id", "title", "statement", "code", "options", "source", "reviewStatus"],
                            "if": {
                                "properties": { "reviewStatus": { "const": "reviewed" } }
                            },
                            "then": {
                                "properties": { "reviewedAt": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" } },
                                "required": ["reviewedAt"]
                            }
                        }
                    }
                },
                "required": ["title", "items"]
            }
        }
    },
    "required": ["id", "Sections"]
}
