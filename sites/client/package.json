{
  "name": "client",
  "version": "5.0.0",
  "description": "Client invoice and payment site for the White Point Survey family of web applications",
  "type": "module",
  "scripts": {
    "dev": "vite --port 5400",
    "build": "pnpm run build:main",
    "build:main": "tsc && vite build --mode main",
    "build:preview": "tsc && vite build --mode preview",
    "preview": "vite preview",
    "deploy": "pnpm run build:main && wrangler pages deploy dist --branch main",
    "deploy:preview": "pnpm run build:preview && wrangler pages deploy dist --branch preview",
    "lint": "eslint . --ext .ts,.tsx,.js,.jsx",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@stripe/react-stripe-js": "6.8.0",
    "@stripe/stripe-js": "9.12.0",
    "cfdg/input": "workspace:*",
    "cfdg/layout": "workspace:*",
    "cfdg/scripts": "workspace:*",
    "cfdg/types": "workspace:*",
    "cfdg/ui": "workspace:*",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-router-dom": "7.18.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.3",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.4",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "vite": "8.1.5",
    "wrangler": "4.114.0"
  }
}
