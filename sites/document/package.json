{
  "name": "sites-document",
  "version": "1.0.0",
  "description": "Document website for SWP",
  "type": "module",
  "scripts": {
    "dev": "vite --port 5200",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "deploy": "pnpm run build && wrangler pages deploy dist --branch main",
    "deploy:preview": "pnpm run build && wrangler pages deploy dist --branch preview",
    "lint": "eslint . --ext .ts,.tsx,.js,.jsx",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@azure/msal-browser": "latest",
    "@azure/msal-react": "latest",
    "@headlessui/react": "latest",
    "@stripe/react-stripe-js": "^6.8.0",
    "@stripe/stripe-js": "^9.12.0",
    "@tailwindcss/vite": "latest",
    "@types/leaflet": "latest",
    "@types/papaparse": "latest",
    "cfdg/input": "workspace:*",
    "cfdg/layout": "workspace:*",
    "cfdg/scripts": "workspace:*",
    "docx": "latest",
    "docxtemplater": "latest",
    "exceljs": "^4.4.0",
    "file-saver": "latest",
    "jspdf": "latest",
    "jspdf-autotable": "latest",
    "leaflet": "latest",
    "lucide-react": "latest",
    "papaparse": "latest",
    "pizzip": "latest",
    "react": "latest",
    "react-dom": "latest",
    "react-leaflet": "latest",
    "react-markdown": "latest",
    "rehype-slug": "latest",
    "remark-gfm": "latest"
  },
  "devDependencies": {
    "@types/file-saver": "latest",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "@vitejs/plugin-react": "latest",
    "react-router-dom": "latest",
    "typescript": "latest",
    "vite": "latest",
    "wrangler": "latest"
  }
}
