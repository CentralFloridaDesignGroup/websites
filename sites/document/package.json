{
  "name": "document",
  "version": "5.0.0",
  "description": "Internal documentation, tools, and applications for the White Point Survey family of web applications",
  "type": "module",
  "scripts": {
    "dev": "vite --port 5200",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "deploy": "pnpm run build && wrangler pages deploy dist --branch main",
    "deploy:preview": "pnpm run build && wrangler pages deploy dist --branch preview",
    "lint": "eslint . --ext .ts,.tsx,.js,.jsx",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@azure/msal-browser": "5.17.1",
    "@azure/msal-react": "5.5.3",
    "@headlessui/react": "2.2.10",
    "@stripe/react-stripe-js": "6.8.0",
    "@stripe/stripe-js": "9.12.0",
    "cfdg/input": "workspace:*",
    "cfdg/layout": "workspace:*",
    "cfdg/scripts": "workspace:*",
    "cfdg/ui": "workspace:*",
    "docx": "9.7.1",
    "docxtemplater": "3.69.3",
    "exceljs": "4.4.0",
    "file-saver": "2.0.5",
    "jspdf": "4.2.1",
    "jspdf-autotable": "5.0.8",
    "leaflet": "1.9.4",
    "lucide-react": "1.26.0",
    "papaparse": "5.5.4",
    "pizzip": "3.2.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-leaflet": "5.0.0",
    "react-markdown": "10.1.0",
    "react-router-dom": "7.18.1",
    "rehype-slug": "6.0.0",
    "remark-gfm": "4.0.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.3",
    "@types/file-saver": "2.0.7",
    "@types/leaflet": "1.9.21",
    "@types/papaparse": "5.5.2",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.4",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "vite": "8.1.5",
    "wrangler": "4.114.0"
  }
}
