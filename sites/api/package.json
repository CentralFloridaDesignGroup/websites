{
  "name": "sites-api",
  "version": "1.0.0",
  "description": "Cloudflare Workers API for SWP",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --env preview --port 8787",
    "typecheck": "tsc --noEmit",
    "d1:migrate:local": "wrangler d1 migrations apply compass --local",
    "d1:migrate:remote": "wrangler d1 migrations apply compass --remote",
    "build": "tsc && wrangler deploy --dry-run",
    "deploy": "tsc && wrangler deploy --env production"
  },
  "dependencies": {
    "cfdg/scripts": "workspace:*",
    "hono": "^4.12.29",
    "jose": "^6.2.3"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "latest",
    "typescript": "latest",
    "wrangler": "latest"
  }
}
