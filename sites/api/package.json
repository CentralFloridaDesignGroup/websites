{
  "name": "api",
  "version": "5.0.0",
  "description": "Cloudflare Worker API for the White Point Survey family of web applications",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --env preview --port 8787",
    "typecheck": "tsc --noEmit",
    "d1:migrate:local": "wrangler d1 migrations apply compass --local",
    "d1:migrate:remote": "wrangler d1 migrations apply compass --remote",
    "build": "tsc && wrangler deploy --dry-run",
    "deploy": "tsc && wrangler deploy --env production"
  },
  "dependencies": {
    "cfdg/scripts": "workspace:*",
    "cfdg/types": "workspace:*",
    "hono": "4.12.32",
    "jose": "6.2.4"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20260724.1",
    "typescript": "5.9.3",
    "wrangler": "4.114.0"
  }
}
