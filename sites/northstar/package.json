{
  "name": "northstar",
  "version": "5.0.0",
  "description": "Internal PM and CRM site for the White Point Survey family of web applications",
  "type": "module",
  "scripts": {
    "dev": "vite --port 5300",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "deploy": "pnpm run build && wrangler pages deploy dist --branch main",
    "deploy:preview": "pnpm run build && wrangler pages deploy dist --branch preview",
    "lint": "eslint . --ext .ts,.tsx,.js,.jsx",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@azure/msal-browser": "5.17.1",
    "@azure/msal-react": "5.5.3",
    "cfdg/input": "workspace:*",
    "cfdg/layout": "workspace:*",
    "cfdg/scripts": "workspace:*",
    "cfdg/types": "workspace:*",
    "cfdg/ui": "workspace:*",
    "lucide-react": "1.26.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-router-dom": "7.18.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.3",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.4",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "vite": "8.1.5",
    "wrangler": "4.114.0"
  }
}
