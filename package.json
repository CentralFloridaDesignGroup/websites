{
  "name": "wps",
  "version": "5.0.0",
  "description": "Websites monorepo for White Point Survey",
  "private": true,
  "workspaces": [
    "packages/**",
    "sites/**"
  ],
  "scripts": {
    "dev:main": "pnpm -r --parallel --filter api --filter main run dev",
    "dev:document": "pnpm -r --parallel --filter api --filter document run dev",
    "dev:northstar": "pnpm -r --parallel --filter api --filter northstar run dev",
    "dev:client": "pnpm -r --parallel --filter api --filter client run dev",
    "dev:api": "pnpm --filter api run dev",

    "build:main": "pnpm --filter main run build",
    "build:document": "pnpm --filter document run build",
    "build:northstar": "pnpm --filter northstar run build",
    "build:client": "pnpm --filter client run build",
    "build:api": "pnpm --filter api run build",
    
    "deploy:main": "pnpm --filter main run deploy",
    "deploy:document": "pnpm --filter document run deploy",
    "deploy:northstar": "pnpm --filter northstar run deploy",
    "deploy:client": "pnpm --filter client run deploy",
    "deploy:api": "pnpm --filter api run deploy",

    "deploy:northstar:preview": "pnpm --filter northstar run deploy:preview",
    "deploy:client:preview": "pnpm --filter client run deploy:preview",
    "deploy:api:preview": "pnpm --filter api run deploy:preview",
  
    "d1:migrate:v1:local": "pnpm --filter api run d1:migrate:v1:local",
    "d1:migrate:v1:remote": "pnpm --filter api run d1:migrate:v1:remote",
    "d1:migrate:ns:local": "pnpm --filter api run d1:migrate:ns:local",
    "d1:migrate:ns:preview:local": "pnpm --filter api run d1:migrate:ns:preview:local",
    "d1:reset:ns:local": "pnpm --filter api run d1:reset:ns:local",
    "d1:reset:ns:preview:local": "pnpm --filter api run d1:reset:ns:preview:local",
    "d1:migrate:ns:remote": "pnpm --filter api run d1:migrate:ns:remote",
    "d1:migrate:ns:preview:remote": "pnpm --filter api run d1:migrate:ns:preview:remote",
    "lint": "eslint .",
    "type-check": "pnpm --filter cfdg/input exec tsc -b && pnpm --filter cfdg/layout exec tsc -b && pnpm --filter cfdg/scripts exec tsc -b && pnpm --filter cfdg/types exec tsc -b && pnpm --filter main exec tsc --noEmit && pnpm --filter document exec tsc --noEmit && pnpm --filter northstar exec tsc --noEmit && pnpm --filter client exec tsc --noEmit && pnpm --filter api exec tsc --noEmit"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "26.1.1",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@typescript-eslint/eslint-plugin": "8.65.0",
    "@typescript-eslint/parser": "8.65.0",
    "eslint": "10.8.0",
    "react": "19.2.8",
    "typescript": "5.9.3"
  }
}
