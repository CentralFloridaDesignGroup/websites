{
  "name": "cfdg/types",
  "version": "5.0.0",
  "description": "Shared types for the White Point Survey family of web applications",
  "type": "module",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc"
  },
  "devDependencies": {
    "typescript": "5.9.3"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./v1": {
      "types": "./dist/v1/index.d.ts",
      "import": "./dist/v1/index.js"
    },
    "./v2": {
      "types": "./dist/v2/index.d.ts",
      "import": "./dist/v2/index.js"
    },
    "./v1/constants": { "types": "./dist/v1/constants/index.d.ts", "import": "./dist/v1/constants/index.js" },
    "./v2/constants": { "types": "./dist/v2/constants/index.d.ts", "import": "./dist/v2/constants/index.js" },
    "./v1/mappers": { "types": "./dist/v1/mappers.d.ts", "import": "./dist/v1/mappers.js" },
    "./v2/mappers": { "types": "./dist/v2/mappers.d.ts", "import": "./dist/v2/mappers.js" },
    "./v1/*": { "types": "./dist/v1/*.d.ts", "import": "./dist/v1/*.js" },
    "./v2/*": { "types": "./dist/v2/*.d.ts", "import": "./dist/v2/*.js" }
  }
}
